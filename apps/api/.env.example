# Supabase project URL, for example: https://your-project.supabase.co
SUPABASE_URL=

# Server-only key. Do not expose this value to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL connection string used to persist user_context.
DATABASE_URL=

# Server-side OpenWeather Current Weather API key.
OPENWEATHER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/callback
# A URL-safe Fernet key generated with: Fernet.generate_key().decode()
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Random secret used to sign short-lived OAuth CSRF state values.
CALENDAR_OAUTH_STATE_SECRET=
FRONTEND_URL=http://localhost:5173
